# Copy to jenkins/.env (git-ignored). Not secret: the secrets live in jenkins/secrets/.
DOCKERHUB_NAMESPACE=your-dockerhub-user
GIT_REPOSITORY_URL=https://github.com/<you>/<repo>.git
KUBECONFIG_PATH=C:/Users/<you>/.kube/config
K8S_FLAVOUR=docker-desktop
LLM_MODE=mock
LLM_MODEL=
SMEE_URL=https://smee.io/<your-channel>
