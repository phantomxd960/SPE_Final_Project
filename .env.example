# Copy to .env for local development. Never commit .env (it is git-ignored).
# In Kubernetes these values come from Vault (or a Secret created by Ansible).

# Database
DB_PASSWORD=regulationdiff

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@regulationdiff.local
ADMIN_PASSWORD=change-me

# AI: mock needs no key and is fully deterministic. For a real model use openai or gemini.
LLM_MODE=mock
LLM_MODEL=
LLM_API_KEY=

# Embeddings: the Docker images ship with fastembed; mock is for running Python locally without the model.
EMBEDDINGS_MODE=fastembed
GRAPH_INFERRED_THRESHOLD=0.75

LOG_LEVEL=INFO
